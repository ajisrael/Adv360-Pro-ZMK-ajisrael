#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * Each event's delay is the time until the next one. A is pressed at 5 s
 * and goes to host A (d_02, profile 0). BT_SEL 1 at 10.2 s; host B (d_03)
 * bonds to profile 1 and gets B at 12.2 s. C goes down at 13.0 s, and host A
 * writes "select me" at about 13.5 s, while C is still held.
 *
 * C is released at 13.8 s: the switch waits for it, so C goes entirely to
 * host B, and the final A (15.3 s) goes to host A.
 */
&kscan {
    events =
    <ZMK_MOCK_PRESS(0,0,5000)
    ZMK_MOCK_RELEASE(0,0,200)
    ZMK_MOCK_PRESS(1,1,10)
    ZMK_MOCK_RELEASE(1,1,2000)
    ZMK_MOCK_PRESS(0,1,500)
    ZMK_MOCK_RELEASE(0,1,300)
    ZMK_MOCK_PRESS(1,0,800)
    ZMK_MOCK_RELEASE(1,0,1500)
    ZMK_MOCK_PRESS(0,0,200)
    ZMK_MOCK_RELEASE(0,0,200)>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp A &kp B
            &kp C &bt BT_SEL 1>;
        };
    };
};
